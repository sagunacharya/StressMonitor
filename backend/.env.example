# Copy this file to ".env" and fill in your real MySQL password.
# app.py / db.py load this automatically -- never commit your real .env.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=stress_dashboard

# Replace this placeholder with a unique secret of at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASH_SECRET_KEY=replace_with_a_unique_random_secret_before_running_123456789

# ESP32-S3 serial port. Windows: COM3, COM4, etc (check Device Manager).
# Linux: /dev/ttyUSB0 or /dev/ttyACM0 (check `ls /dev/tty*` after plugging
# in, or `dmesg | tail` right after plugging in). macOS: /dev/cu.usbserial-*
# or /dev/cu.SLAB_USBtoUART depending on the USB-serial chip.
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200

# Optional application binding. Default is local-only; use 0.0.0.0 only if
# you intentionally want LAN access and have considered the network risk.
DASH_HOST=127.0.0.1
DASH_PORT=5000
SESSION_COOKIE_SECURE=0

# Optional local research-only feature CSV logging (off by default for privacy).
ENABLE_FEATURE_CSV_LOG=0
